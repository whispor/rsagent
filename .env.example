# Copy this file to `.env` and fill in your values.
# rsagent loads `.env` from the working directory at startup.

# Base URL of an OpenAI Chat Completions-compatible endpoint.
RSAGENT_BASE_URL=https://api.openai.com/v1

# API key for that endpoint.
RSAGENT_API_KEY=sk-...

# Model id to use.
RSAGENT_MODEL=gpt-4o-mini
