# Copy this file to `.env` and fill in your values.
# rsagent loads `.env` from the working directory (and its parents) at startup.

# API key for the endpoint.
RSAGENT_API_KEY=sk-...

# Model id to use.
RSAGENT_MODEL=gpt-4o-mini

# To point at a non-default endpoint, set the base URL in your *environment* or pass
# `--base-url`. It is deliberately NOT read from `.env`: a `.env` that arrived with a
# `git clone` could otherwise redirect your API key to an attacker's server.
#   export RSAGENT_BASE_URL=https://api.deepseek.com/v1
#   rsagent --base-url https://api.deepseek.com/v1 ...
